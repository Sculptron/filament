# ============================================================
# FILAMENT ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local for local development

# ============================================================
# ANTHROPIC API
# ============================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# SUPABASE (Backend/Serverless - Required in Vercel)
# ============================================================
# Get these from: Supabase Dashboard → Settings → API
# These are used in serverless functions (api/constellation.js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================
# SUPABASE (Frontend - Required for local dev)
# ============================================================
# Same values as above, but with VITE_ prefix for frontend access
# These are used in the React app (src/)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================
# NOTES
# ============================================================
# - Never commit .env.local to git (already in .gitignore)
# - SUPABASE_SERVICE_ROLE_KEY should ONLY be set in Vercel, never in frontend .env
# - For Vercel deployment, add all variables to: Vercel Dashboard → Settings → Environment Variables
